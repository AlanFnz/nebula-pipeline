#!/bin/zsh
set -eu
cd "$(dirname "$0")/../../.."
nebula_root="$PWD"
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
if [[ ! -x .venv/bin/python ]]; then
    /usr/bin/osascript -e 'display alert "Nebula Studio needs setup" message "Follow the one-time setup in the repository README, then open this app again."'
    exit 1
fi
mkdir -p .validation
exec "$nebula_root/.venv/bin/python" "$nebula_root/studio.py" "$@" >> .validation/studio.log 2>&1
